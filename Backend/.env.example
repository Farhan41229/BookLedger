# BookLedger - Environment Variables Example
# Copy this file to .env or config/config.env and fill in your actual values

# Server Configuration
PORT=4000
NODE_ENV=development

# Database
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/MERN_LMS
MONGODB_URL=

# Authentication
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Services
GEMINI_API_KEY=
GROQ_API_KEY=

# Email Services
# Brevo (formerly Sendinblue)
BREVO_API_KEY=
# Mailtrap (for development testing)
MAILTRAP_TOKEN=
